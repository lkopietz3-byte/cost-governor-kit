{
  "name": "cost-governor-kit",
  "version": "0.1.0",
  "description": "Pre-call AI spend ceilings, cache-aware token pricing with caller-supplied rates, and reserve/confirm usage-counting helpers whose limits are enforced by your own storage adapter.",
  "keywords": [
    "llm",
    "ai",
    "cost",
    "pricing",
    "spend-limit",
    "budget",
    "prompt-caching",
    "quota",
    "usage-limit",
    "anthropic"
  ],
  "author": "Lucas Kopietz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lkopietz3-byte/cost-governor-kit.git"
  },
  "homepage": "https://github.com/lkopietz3-byte/cost-governor-kit#readme",
  "bugs": {
    "url": "https://github.com/lkopietz3-byte/cost-governor-kit/issues"
  },
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pricing": {
      "types": "./dist/pricing.d.ts",
      "import": "./dist/pricing.js"
    },
    "./preCallCeiling": {
      "types": "./dist/preCallCeiling.d.ts",
      "import": "./dist/preCallCeiling.js"
    },
    "./reserveConfirm": {
      "types": "./dist/reserveConfirm.d.ts",
      "import": "./dist/reserveConfirm.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "reference-impl",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:postgres": "vitest run src/referenceImplPostgres.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "verify:package": "node scripts/verify-package.mjs",
    "lint": "eslint . --max-warnings=0",
    "audit:dependencies": "npm audit --package-lock-only --include=dev --ignore-scripts --audit-level=low",
    "prepare": "npm run build",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:package",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "pg": "8.23.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
