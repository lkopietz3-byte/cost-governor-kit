{
  "name": "cost-governor-kit",
  "version": "0.1.0",
  "description": "Three cost-safety properties every AI-calling app should have, assembled into one library: a pre-call dollar ceiling with live caller-supplied rates, correct cache-aware pricing math, and a reserve-then-confirm atomic usage-counting contract.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pricing": {
      "types": "./dist/pricing.d.ts",
      "import": "./dist/pricing.js"
    },
    "./preCallCeiling": {
      "types": "./dist/preCallCeiling.d.ts",
      "import": "./dist/preCallCeiling.js"
    },
    "./reserveConfirm": {
      "types": "./dist/reserveConfirm.d.ts",
      "import": "./dist/reserveConfirm.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "reference-impl",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
