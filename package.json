{
  "name": "@evidencekit/spend-limits",
  "version": "0.3.1",
  "description": "AI spend limits for apps that call paid model APIs: pre-call spend ceilings, cache-aware token pricing with caller-supplied rates, and reserve/confirm usage counting enforced by your own storage adapter.",
  "keywords": [
    "llm",
    "ai",
    "cost",
    "pricing",
    "spend-limit",
    "budget",
    "prompt-caching",
    "quota",
    "usage-limit",
    "anthropic",
    "cost-governor-kit",
    "evidence-kit"
  ],
  "author": "Lucas Kopietz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evidencekit/spend-limits.git"
  },
  "homepage": "https://github.com/evidencekit/spend-limits#readme",
  "bugs": {
    "url": "https://github.com/evidencekit/spend-limits/issues"
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pricing": {
      "types": "./dist/pricing.d.ts",
      "import": "./dist/pricing.js",
      "default": "./dist/pricing.js"
    },
    "./preCallCeiling": {
      "types": "./dist/preCallCeiling.d.ts",
      "import": "./dist/preCallCeiling.js",
      "default": "./dist/preCallCeiling.js"
    },
    "./reserveConfirm": {
      "types": "./dist/reserveConfirm.d.ts",
      "import": "./dist/reserveConfirm.js",
      "default": "./dist/reserveConfirm.js"
    },
    "./admission": {
      "types": "./dist/admission.d.ts",
      "import": "./dist/admission.js",
      "default": "./dist/admission.js"
    }
  },
  "typesVersions": {
    "*": {
      "pricing": [
        "./dist/pricing.d.ts"
      ],
      "preCallCeiling": [
        "./dist/preCallCeiling.d.ts"
      ],
      "reserveConfirm": [
        "./dist/reserveConfirm.d.ts"
      ],
      "admission": [
        "./dist/admission.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "reference-impl",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:postgres": "vitest run --no-file-parallelism src/referenceImplPostgres.test.ts src/capacityLedgerPostgres.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "verify:package": "node scripts/verify-package.mjs",
    "attw": "attw --pack . --ignore-rules cjs-resolves-to-esm",
    "lint": "eslint . --max-warnings=0",
    "audit:dependencies": "npm audit --package-lock-only --include=dev --ignore-scripts --audit-level=low",
    "prepare": "npm run build",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:package",
    "prepublishOnly": "npm run verify",
    "verify:observatory": "node examples/observatory/tools/verify-source.mjs --source . && node --test examples/observatory/tests/session.check.mjs examples/observatory/tests/insights.check.mjs examples/observatory/tests/notebook.check.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "pg": "8.23.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
